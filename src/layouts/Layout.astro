---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

interface Props {
 title: string;
 description?: string;
 image?: string;
 intro?: boolean;
}

const { title, description = "Профессиональный фотограф в Черногории.", image, intro = false } = Astro.props;
const structuredData = {
 '@context': 'https://schema.org',
 '@type': 'ProfessionalService',
 name: 'Dmitry Kriukov',
 jobTitle: 'Photographer',
 description,
 areaServed: 'Montenegro',
 serviceType: 'Photography',
};
---

<!doctype html>
<html lang="ru" class="bg-neutral-950 text-neutral-100 scroll-smooth">
 <head>
  <meta charset="UTF-8" />
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width" />
  <meta name="theme-color" content="#0a0a0a" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {image && <meta name="twitter:image" content={image} />}
  <link rel="preconnect" href="https://images.unsplash.com" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <title>{title}</title>
 </head>
 <body class="min-h-screen flex flex-col font-sans bg-neutral-950 text-white">
   {intro && <div class="intro-screen" aria-hidden="true">
    <div class="camera-animation"><div class="camera-body">
     <span class="camera-viewfinder"></span><span class="camera-lens"><span></span></span><span class="camera-shutter"></span>
    </div><span class="camera-flash"></span></div>
   </div>}
    <header class="mx-auto flex w-full max-w-7xl flex-col gap-6 border-b border-neutral-800 px-6 py-8 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="whitespace-nowrap text-xl font-bold uppercase tracking-widest text-white">Dmitry Kriukov</a>
    <nav class="flex w-full items-center justify-between gap-4 text-xs uppercase tracking-[0.16em] text-neutral-400 sm:w-auto sm:justify-normal sm:gap-8">
      <a href="/portfolio" class="transition-colors hover:text-white" data-en="Portfolio" data-ru="Портфолио">Portfolio</a>
      <a href="/#about" class="hidden transition-colors hover:text-white sm:block" data-en="About" data-ru="Обо мне">About</a>
      <a href="/#contacts" class="transition-colors hover:text-white" data-en="Contact" data-ru="Контакты">Contact</a>
      <span class="h-4 w-px bg-neutral-700" aria-hidden="true"></span>
      <span class="flex items-center gap-2" aria-label="Language">
       <button type="button" data-language="en" class="language-button text-white" aria-label="Switch to English" aria-pressed="true">EN</button>
       <span class="text-neutral-700">/</span>
       <button type="button" data-language="ru" class="language-button" aria-label="Переключить на русский" aria-pressed="false">RU</button>
      </span>
   </nav>
  </header>

  <main class="grow w-full max-w-7xl mx-auto px-6 py-12">
   <slot />
  </main>

  <footer class="w-full max-w-7xl mx-auto px-6 py-12 border-t border-neutral-800 text-center text-neutral-500 text-sm">
   © {new Date().getFullYear()} Dmitry Kriukov. <span data-en="All rights reserved." data-ru="Все права защищены.">All rights reserved.</span>
  </footer>
 </body>
</html>

<Analytics />

<script is:inline>
 const languageButtons = document.querySelectorAll('[data-language]');
 const languageKey = 'dmitry-kriukov-language';

 const setLanguage = (language) => {
  document.documentElement.lang = language;
  document.querySelectorAll('[data-en][data-ru]').forEach((element) => {
   element.textContent = language === 'ru' ? element.dataset.ru : element.dataset.en;
  });
  languageButtons.forEach((button) => {
   const active = button.dataset.language === language;
   button.classList.toggle('text-white', active);
   button.classList.toggle('text-neutral-500', !active);
   button.setAttribute('aria-pressed', String(active));
  });
  localStorage.setItem(languageKey, language);
  document.dispatchEvent(new CustomEvent('languagechange', { detail: language }));
 };

 const savedLanguage = localStorage.getItem(languageKey);
 setLanguage(savedLanguage === 'ru' ? 'ru' : 'en');
 languageButtons.forEach((button) => button.addEventListener('click', () => setLanguage(button.dataset.language)));

 const revealItems = document.querySelectorAll('[data-reveal]');
 if ('IntersectionObserver' in window) {
  const revealObserver = new IntersectionObserver((entries, observer) => {
   entries.forEach((entry) => {
    if (!entry.isIntersecting) return;
    entry.target.classList.add('is-visible');
    observer.unobserve(entry.target);
   });
  }, { threshold: 0.12 });
  revealItems.forEach((item) => revealObserver.observe(item));
 } else {
  revealItems.forEach((item) => item.classList.add('is-visible'));
 }
</script>