---
import Layout from '../layouts/Layout.astro';
import AlbumCard from '../components/AlbumCard.astro';
import { albums } from '../data/albums';
---

<Layout title="Свадебный и портретный фотограф в Черногории | Портфолио" description="Избранные свадебные истории, love story и портретные съемки в Баре, Будве, Которе и Перасте." image={albums[0].cover}>
 <section class="mb-16 max-w-3xl" data-reveal>
    <p class="mb-5 text-xs uppercase tracking-[0.28em] text-neutral-500" data-en="Story archive" data-ru="Архив историй">Story archive</p>
   <h1 class="text-5xl font-medium tracking-tight text-white md:text-7xl" data-en="Stories from Montenegro." data-ru="Истории из Черногории.">Stories from Montenegro.</h1>
    <p class="mt-7 max-w-xl text-lg leading-relaxed text-neutral-400" data-en="Wedding stories, love stories and portraits made with space to feel like yourselves." data-ru="Свадебные истории, лавстори и портреты, в которых есть место быть собой.">Wedding stories, love stories and portraits made with space to feel like yourselves.</p>
 </section>

 <section class="grid gap-x-6 gap-y-12 md:grid-cols-2">
  {albums.map((album, index) => <AlbumCard album={album} featured={index === 0} />)}
 </section>
</Layout>